OPENROUTER_API_KEY=

# Backend auth API (keep the service role key on the server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret for POST /auth/users (send it as the X-Admin-Key header).
# Only checked when REQUIRE_ADMIN_KEY = True in auth_api.py (currently off).
# With the check on, leaving this empty disables creating users through the API.
ADMIN_API_KEY=

# Where the Streamlit app finds the auth API
AUTH_API_URL=http://127.0.0.1:8000

# Booking.com MCP hotel agent (approved Demand API partners only)
BOOKING_AFFILIATE_ID=
BOOKING_API_KEY=

# Supabase MCP server (travel agent): a PERSONAL ACCESS TOKEN (sbp_...) from
# Supabase dashboard > Account > Access Tokens. Not the service role key.
SUPABASE_ACCESS_TOKEN=

# RouteStack flights MCP: API key (live_rst_...) AND API secret (live_...) from the
# RouteStack dashboard. The app exchanges them for a login token; the secret is never sent.
ROUTERSTACK_API_KEY=
ROUTERSTACK_API_SECRET=

# Xweather MCP: "<client_id>_<client_secret>" from the Xweather dashboard (Apps)
XWEATHER_API_KEY=
