# OpenRouter key: used for embeddings, the RAG agent and the DeepEval judge model
OPENROUTER_API_KEY=

# Login (auth_api.py): Supabase project URL and SECRET key (sb_secret_... or the legacy
# service_role key). Keep the secret key on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret for POST /auth/users (X-Admin-Key header); only checked when
# REQUIRE_ADMIN_KEY = True in auth_api.py.
ADMIN_API_KEY=

# Where main_app.py finds the auth API
AUTH_API_URL=http://127.0.0.1:8000
